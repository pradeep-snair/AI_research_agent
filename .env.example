# Copy to .env and replace placeholders with your own settings.
BASE_URL=https://your-model-server.example/v1
API_KEY=replace-with-your-api-key
EMBEDDING_MODEL=replace-with-your-embedding-model
# Relative paths are resolved from the project root.
DATA_FOLDER_PATH=./data
# Optional: defaults to qwen3.5 when omitted or empty.
MODEL=qwen3.5
# Set this to use Brave Search through your MCP gateway.
BRAVE_SEARCH_MCP_URL=
